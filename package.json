{
  "name": "tailscale-ts-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.11"
  },
  "scripts": {
    "test": "bun run --filter '*' test",
    "test:danger": "bun run --filter '*' test:danger",
    "debug": "bun run --filter 'tailscaled.ts' debug",
    "dev": "bun run --filter 'panescale' dev",
    "docs": "bun run --filter 'docs' dev",
    "format": "biome format --write .",
    "check": "biome check ."
  }
}
